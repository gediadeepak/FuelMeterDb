<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FuelMeter.MainPage">

    <Grid>
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" />

        <!-- Splash overlay: shown on top of the BlazorWebView until the app is ready.
             We overlay rather than swap Window.Page to avoid the Android fragment
             "No view found for id ... jumpToStart" crash. -->
        <Grid x:Name="SplashOverlay"
              BackgroundColor="#FFFFFF"
              RowDefinitions="*, Auto, *">

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="20"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Image Source="fuelmeter_logo_img.png"
                       WidthRequest="140"
                       HeightRequest="140"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <Label Text="FuelMeter"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#1976D2"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="Track · Monitor · Save"
                       FontSize="14"
                       TextColor="#546E7A"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ProgressBar Grid.Row="2"
                         x:Name="LoadingBar"
                         Progress="0"
                         ProgressColor="#1976D2"
                         VerticalOptions="End"
                         Margin="40,0,40,48" />
        </Grid>
    </Grid>

</ContentPage>
