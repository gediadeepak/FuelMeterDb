@page "/dashboard"
@using FuelMeter.Core.DTOs
@using FuelMeter.Core.Services
@using FuelMeter.Core.Services.Interfaces
@layout MainLayout
@inject IMeterReadingService MeterService
@inject IBudgetService BudgetService
@inject IBillEstimationService BillService
@inject IAnomalyService AnomalyService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="dashboard">

    <div class="dash-header">
        <div>
            <h1 class="dash-title">Dashboard</h1>
            <p class="dash-subtitle">Monthly overview based on the readings entered for each fuel type.</p>
        </div>
        <!-- Month selector -->
        <select class="dash-month-select" @bind="_selectedMonth" @bind:after="LoadAsync">
            @foreach (var m in _monthOptions)
            {
                <option value="@m.Value">@m.Label</option>
            }
        </select>
    </div>

    @if (!_loadingMain && _data is null)
    {
        <div class="dash-empty">⚠️ Could not load data. Please check your connection.</div>
    }

    @if (!_loadingAnomalies && _anomalies?.Anomalies.Count > 0)
    {
        <div class="anomaly-banner">
            <div class="anomaly-banner-header">
                <span class="anomaly-icon">🚨</span>
                <strong>Unusual usage detected</strong>
                <span class="anomaly-count">@_anomalies.Anomalies.Count flagged day(s)</span>
            </div>
            <ul class="anomaly-list">
                @foreach (var a in _anomalies.Anomalies.Take(3))
                {
                    <li>
                        <span class="@(a.FuelType == "Electricity" ? "blue" : "green")">
                            @(a.FuelType == "Electricity" ? "⚡" : "🔥") @a.FuelType
                        </span>
                        on <strong>@a.Date.ToString("dd MMM")</strong>:
                        <strong>@a.DailyUsage.ToString("N1")</strong> vs avg @a.RollingAverage.ToString("N1")
                        <span class="@(a.Severity == "High" ? "anomaly-high" : "anomaly-warn")">
                            (+@a.PercentAboveAverage.ToString("N0")%)
                        </span>
                    </li>
                }
            </ul>
            <a href="/anomalies" class="anomaly-link">View all anomalies →</a>
        </div>
    }

    @if (_data is not null)
    {
        @if (!_data.HasReadings)
        {
            <div class="dash-no-readings">
                📭 No readings for @(new DateTime(_data.Year, _data.Month, 1).ToString("MMMM yyyy")).
                <a href="/add-reading">Add a reading →</a>
            </div>
        }

        <!-- Summary Cards -->
        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-label">Electricity Used</span>
                <span class="stat-value blue">@_data.ElectricityUsage.ToString("N0") kWh</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Electricity Cost</span>
                <span class="stat-value blue">@_data.CurrencySymbol@_data.ElectricityCost.ToString("N2")</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Gas Used</span>
                <span class="stat-value green">@_data.GasUsage.ToString("N0") units</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Gas Cost</span>
                <span class="stat-value green">@_data.CurrencySymbol@_data.GasCost.ToString("N2")</span>
            </div>
        </div>

        <!-- Donut Charts -->
        <div class="chart-row">
            <div class="chart-card">
                <span class="chart-title">Electricity Live Usage</span>
                <div class="donut-wrap">
                    <svg viewBox="0 0 120 120" class="donut">
                        <circle cx="60" cy="60" r="48" fill="none" stroke="#E3EEFF" stroke-width="14"/>
                        <circle cx="60" cy="60" r="48" fill="none" stroke="var(--fm-blue)" stroke-width="14"
                                stroke-dasharray="@ElecArc 302" stroke-dashoffset="75"
                                stroke-linecap="round"/>
                    </svg>
                    <div class="donut-label">
                        <span class="donut-value blue">@_data.CurrencySymbol@((int)_data.ElectricityCost)</span>
                        <span class="donut-sub">This Month</span>
                    </div>
                </div>
            </div>
            <div class="chart-card">
                <span class="chart-title">Gas Live Usage</span>
                <div class="donut-wrap">
                    <svg viewBox="0 0 120 120" class="donut">
                        <circle cx="60" cy="60" r="48" fill="none" stroke="#E3EEFF" stroke-width="14"/>
                        <circle cx="60" cy="60" r="48" fill="none" stroke="#2E7D32" stroke-width="14"
                                stroke-dasharray="@GasArc 302" stroke-dashoffset="75"
                                stroke-linecap="round"/>
                    </svg>
                    <div class="donut-label">
                        <span class="donut-value green">@_data.CurrencySymbol@((int)_data.GasCost)</span>
                        <span class="donut-sub">This Month</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Cards -->
        <div class="detail-row">
            <div class="detail-card">
                <h3 class="detail-title">Electricity</h3>
                @if (!string.IsNullOrEmpty(_data.ElectricityProvider))
                {
                    <p class="detail-line"><span>Provider:</span> @_data.ElectricityProvider</p>
                }
                <p class="detail-line"><span>Price per kWh:</span> @_data.CurrencySymbol@_data.ElectricityRate.ToString("0.00##")</p>
                @if (_data.ElectricityStandingCharge > 0)
                {
                    <p class="detail-line"><span>Standing charge:</span> @_data.ElectricityStandingCharge.ToString("0.00##")p/day (@_data.CurrencySymbol@_data.ElectricityStandingCost.ToString("N2") this month)</p>
                    <p class="detail-line"><span>Usage cost:</span> @_data.CurrencySymbol@_data.ElectricityUsageCost.ToString("N2")</p>
                }
                <div class="progress-bar-wrap">
                    <div class="progress-bar blue" style="width:@ElecProgressPct%"></div>
                </div>
                <p class="detail-total">Total this month: <strong>@_data.CurrencySymbol@_data.ElectricityCost.ToString("N2")</strong></p>
                @if (_data.ElectricityBudget > 0)
                {
                    <p class="detail-budget">Budget: @_data.CurrencySymbol@_data.ElectricityBudget.ToString("N2")</p>
                }
            </div>
            <div class="detail-card">
                <h3 class="detail-title">Gas</h3>
                @if (!string.IsNullOrEmpty(_data.GasProvider))
                {
                    <p class="detail-line"><span>Provider:</span> @_data.GasProvider</p>
                }
                <p class="detail-line"><span>Price per unit:</span> @_data.CurrencySymbol@_data.GasRate.ToString("0.00##")</p>
                @if (_data.GasStandingCharge > 0)
                {
                    <p class="detail-line"><span>Standing charge:</span> @_data.GasStandingCharge.ToString("0.00##")p/day (@_data.CurrencySymbol@_data.GasStandingCost.ToString("N2") this month)</p>
                    <p class="detail-line"><span>Usage cost:</span> @_data.CurrencySymbol@_data.GasUsageCost.ToString("N2")</p>
                }
                <div class="progress-bar-wrap">
                    <div class="progress-bar green" style="width:@GasProgressPct%"></div>
                </div>
                <p class="detail-total">Total this month: <strong>@_data.CurrencySymbol@_data.GasCost.ToString("N2")</strong></p>
                @if (_data.GasBudget > 0)
                {
                    <p class="detail-budget">Budget: @_data.CurrencySymbol@_data.GasBudget.ToString("N2")</p>
                }
            </div>
        </div>

        <!-- Formula Hint -->
        <div class="formula-hint">
            💡 <em>Formula: usage = latest meter reading − first meter reading for the selected month. Cost = (usage × price per unit) + (standing charge p/day ÷ 100 × days in month).</em>
        </div>
    }

    <!-- Projected End-of-Month Bill -->
    @if (_projectionAvailable)
    {
        if (_loadingProjection)
        {
            <div class="section-loading">⏳ Loading projection…</div>
        }
        else if (_data is not null && (_electricityProjected > 0 || _gasProjected > 0))
        {
            <div class="projection-widget">
                <h3 class="widget-title">🔮 Projected End-of-Month Bill</h3>
                <p class="projection-sub">
                    Based on @_daysElapsed of @_daysInMonth days. Forecast extrapolates current spend across the full month.
                </p>
                <div class="projection-grid">
                    <div class="projection-card @GetProjectionClass(_electricityProjected, _data.ElectricityBudget)">
                        <div class="projection-header">
                            <span class="icon">⚡</span>
                            <span>Electricity</span>
                        </div>
                        <div class="projection-value">@_data.CurrencySymbol@_electricityProjected.ToString("N2")</div>
                        <div class="projection-meta">
                            So far: @_data.CurrencySymbol@_data.ElectricityCost.ToString("N2")
                            @if (_data.ElectricityBudget > 0)
                            {
                                <span> · Budget: @_data.CurrencySymbol@_data.ElectricityBudget.ToString("N2")</span>
                                @if (_electricityProjected > _data.ElectricityBudget)
                                {
                                    <span class="over-pill">Over by @_data.CurrencySymbol@((_electricityProjected - _data.ElectricityBudget).ToString("N2"))</span>
                                }
                                else
                                {
                                    <span class="under-pill">Under by @_data.CurrencySymbol@((_data.ElectricityBudget - _electricityProjected).ToString("N2"))</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="projection-card @GetProjectionClass(_gasProjected, _data.GasBudget)">
                        <div class="projection-header">
                            <span class="icon">🔥</span>
                            <span>Gas</span>
                        </div>
                        <div class="projection-value">@_data.CurrencySymbol@_gasProjected.ToString("N2")</div>
                        <div class="projection-meta">
                            So far: @_data.CurrencySymbol@_data.GasCost.ToString("N2")
                            @if (_data.GasBudget > 0)
                            {
                                <span> · Budget: @_data.CurrencySymbol@_data.GasBudget.ToString("N2")</span>
                                @if (_gasProjected > _data.GasBudget)
                                {
                                    <span class="over-pill">Over by @_data.CurrencySymbol@((_gasProjected - _data.GasBudget).ToString("N2"))</span>
                                }
                                else
                                {
                                    <span class="under-pill">Under by @_data.CurrencySymbol@((_data.GasBudget - _gasProjected).ToString("N2"))</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Budget Summary Widget -->
    @if (_loadingBudgets)
    {
        <div class="section-loading">⏳ Loading budgets…</div>
    }
    else if (_data is not null && _budgetSummaries.Any())
    {
            <div class="budget-widget">
                <h3 class="widget-title">📊 Budget Summary - @(new DateTime(_data.Year, _data.Month, 1).ToString("MMMM yyyy"))</h3>
                <div class="budget-cards">
                    @foreach (var summary in _budgetSummaries)
                    {
                        <div class="mini-budget-card @(summary.IsOverBudget ? "over" : "")">
                            <div class="mini-header">
                                <span class="mini-icon">@(summary.FuelType == "Electricity" ? "⚡" : "🔥")</span>
                                <span class="mini-fuel">@summary.FuelType</span>
                            </div>
                            <div class="mini-progress">
                                <div class="mini-bar @(summary.IsOverBudget ? "over" : "")" 
                                     style="width: @Math.Min(summary.PercentageUsed, 100)%"></div>
                            </div>
                            <div class="mini-stats">
                                <span>@_data.CurrencySymbol@summary.ActualSpent.ToString("N2") / @_data.CurrencySymbol@summary.BudgetLimit.ToString("N2")</span>
                                <span class="@(summary.IsOverBudget ? "over-text" : "")">@summary.PercentageUsed.ToString("N0")%</span>
                            </div>
                        </div>
                    }
                </div>
                <a href="/budget-management" class="widget-link">Manage Budgets →</a>
            </div>
        }

        <!-- Bill Comparison Widget -->
        @if (_loadingComparison)
        {
            <div class="section-loading">⏳ Loading comparison…</div>
        }
        else if (_data is not null && (_electricityComparison != null || _gasComparison != null))
        {
            <div class="comparison-widget">
                <h3 class="widget-title">📈 Bill Comparison vs Last Month</h3>
                <div class="comparison-grid">
                    @if (_electricityComparison != null)
                    {
                        <div class="comparison-card">
                            <div class="comparison-header">
                                <span class="icon">⚡</span>
                                <span>Electricity</span>
                            </div>
                            <div class="comparison-amounts">
                                <div class="amount current">
                                    <span class="label">This Month</span>
                                    <span class="value">@_data.CurrencySymbol@_electricityComparison.CurrentMonthBill.ToString("N2")</span>
                                </div>
                                <div class="amount previous">
                                    <span class="label">Last Month</span>
                                    <span class="value">@_data.CurrencySymbol@_electricityComparison.PreviousMonthBill.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="comparison-change @GetTrendClass(_electricityComparison.Trend)">
                                @if (_electricityComparison.Trend == "New")
                                {
                                    <span>✨ New — no previous month data</span>
                                }
                                else
                                {
                                    <span>@GetTrendIcon(_electricityComparison.Trend)</span>
                                    <span>@_data.CurrencySymbol@Math.Abs(_electricityComparison.ChangeAmount).ToString("N2")</span>
                                    <span>(@Math.Abs(_electricityComparison.ChangePercentage).ToString("N1")%)</span>
                                }
                            </div>
                        </div>
                    }
                    @if (_gasComparison != null)
                    {
                        <div class="comparison-card">
                            <div class="comparison-header">
                                <span class="icon">🔥</span>
                                <span>Gas</span>
                            </div>
                            <div class="comparison-amounts">
                                <div class="amount current">
                                    <span class="label">This Month</span>
                                    <span class="value">@_data.CurrencySymbol@_gasComparison.CurrentMonthBill.ToString("N2")</span>
                                </div>
                                <div class="amount previous">
                                    <span class="label">Last Month</span>
                                    <span class="value">@_data.CurrencySymbol@_gasComparison.PreviousMonthBill.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="comparison-change @GetTrendClass(_gasComparison.Trend)">
                                @if (_gasComparison.Trend == "New")
                                {
                                    <span>✨ New — no previous month data</span>
                                }
                                else
                                {
                                    <span>@GetTrendIcon(_gasComparison.Trend)</span>
                                    <span>@_data.CurrencySymbol@Math.Abs(_gasComparison.ChangeAmount).ToString("N2")</span>
                                    <span>(@Math.Abs(_gasComparison.ChangePercentage).ToString("N1")%)</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

</div>

@code {
    private DashboardDto? _data;
    private bool _loadingMain = true;
    private bool _loadingBudgets;
    private bool _loadingComparison;
    private bool _loadingProjection;
    private bool _loadingAnomalies;
    private AnomalyResultDto? _anomalies;
    private string _selectedMonth = DateTime.Today.ToString("yyyy-MM");
    private List<BudgetSummaryDto> _budgetSummaries = new();
    private BillComparisonDto? _electricityComparison;
    private BillComparisonDto? _gasComparison;

    // Projection (end-of-month forecast) — only meaningful for the current, in-progress month
    private decimal _electricityProjected;
    private decimal _gasProjected;
    private bool    _projectionAvailable;
    private int     _daysElapsed;
    private int     _daysInMonth;

    private record MonthOption(string Value, string Label);
    private List<MonthOption> _monthOptions = Enumerable
        .Range(0, 12)
        .Select(i => DateTime.Today.AddMonths(-i))
        .Select(d => new MonthOption(d.ToString("yyyy-MM"), d.ToString("MMMM yyyy")))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication before loading data
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!AuthState.IsAuthenticated) return;
        if (!DateTime.TryParse(_selectedMonth + "-01", out var parsed)) return;

        var userId = AuthState.CurrentUser!.Id;
        var today = DateTime.Today;

        // Reset all section states
        _loadingMain = true;
        _loadingBudgets = true;
        _loadingComparison = true;
        _loadingAnomalies = true;
        _anomalies = null;
        _projectionAvailable = parsed.Year == today.Year && parsed.Month == today.Month;
        _loadingProjection = _projectionAvailable;
        _data = null;
        _budgetSummaries = new List<BudgetSummaryDto>();
        _electricityComparison = null;
        _gasComparison = null;
        _electricityProjected = 0;
        _gasProjected = 0;
        if (_projectionAvailable)
        {
            _daysInMonth = DateTime.DaysInMonth(parsed.Year, parsed.Month);
            _daysElapsed = Math.Min(today.Day, _daysInMonth);
        }
        StateHasChanged();

        // Kick off each section independently and update UI as each one completes
        var mainTask = LoadMainAsync(userId, parsed.Year, parsed.Month);
        var budgetsTask = LoadBudgetsAsync(userId, parsed.Year, parsed.Month);
        var comparisonTask = LoadComparisonAsync(userId, parsed.Year, parsed.Month);
        var projectionTask = _projectionAvailable
            ? LoadProjectionAsync(userId, parsed.Year, parsed.Month)
            : Task.CompletedTask;
        var anomaliesTask = LoadAnomaliesAsync(userId);

        await Task.WhenAll(mainTask, budgetsTask, comparisonTask, projectionTask, anomaliesTask);
    }

    private async Task LoadAnomaliesAsync(int userId)
    {
        try { _anomalies = await AnomalyService.DetectAnomaliesAsync(userId); }
        catch { _anomalies = null; }
        finally
        {
            _loadingAnomalies = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMainAsync(int userId, int year, int month)
    {
        try { _data = await MeterService.GetDashboardAsync(userId, year, month); }
        catch { _data = null; }
        finally
        {
            _loadingMain = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadBudgetsAsync(int userId, int year, int month)
    {
        try
        {
            var list = new List<BudgetSummaryDto>();
            try
            {
                var elec = await BudgetService.GetBudgetSummaryAsync(userId, "Electricity", year, month);
                if (elec != null) list.Add(elec);
            }
            catch { }
            try
            {
                var gas = await BudgetService.GetBudgetSummaryAsync(userId, "Gas", year, month);
                if (gas != null) list.Add(gas);
            }
            catch { }
            _budgetSummaries = list;
        }
        finally
        {
            _loadingBudgets = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadComparisonAsync(int userId, int year, int month)
    {
        try
        {
            try { _electricityComparison = await BillService.CompareBillsAsync(userId, "Electricity", year, month); }
            catch { _electricityComparison = null; }
            try { _gasComparison = await BillService.CompareBillsAsync(userId, "Gas", year, month); }
            catch { _gasComparison = null; }
        }
        finally
        {
            _loadingComparison = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadProjectionAsync(int userId, int year, int month)
    {
        try
        {
            try { _electricityProjected = await BillService.ProjectMonthlyBillAsync(userId, "Electricity", year, month); }
            catch { _electricityProjected = 0; }
            try { _gasProjected = await BillService.ProjectMonthlyBillAsync(userId, "Gas", year, month); }
            catch { _gasProjected = 0; }
        }
        finally
        {
            _loadingProjection = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetProjectionClass(decimal projected, decimal budget)
    {
        if (budget <= 0) return "projection-neutral";
        return projected > budget ? "projection-over" : "projection-under";
    }

    // Donut arc: 302 = full circumference (2πr ≈ 2×3.14×48)
    private double ElecArc => _data is null ? 0 : CalcArc(_data.ElectricityCost, _data.ElectricityBudget);
    private double GasArc  => _data is null ? 0 : CalcArc(_data.GasCost, _data.GasBudget);

    private static double CalcArc(decimal cost, decimal budget)
    {
        if (budget <= 0) return cost > 0 ? 220 : 0;  // no budget — show ~73% as indicator
        double pct = Math.Min(1.0, (double)(cost / budget));
        return Math.Round(pct * 302, 1);
    }

    // Progress bar percentage
    private double ElecProgressPct => _data is null ? 0 : CalcPct(_data.ElectricityCost, _data.ElectricityBudget);
    private double GasProgressPct  => _data is null ? 0 : CalcPct(_data.GasCost, _data.GasBudget);

    private static double CalcPct(decimal cost, decimal budget) =>
        budget > 0
            ? Math.Min(100, Math.Round((double)(cost / budget * 100), 1))
            : (cost > 0 ? 65 : 0);

    private string GetTrendClass(string trend) => trend switch
    {
        "Up" => "trend-up",
        "Down" => "trend-down",
        "New" => "trend-new",
        _ => "trend-same"
    };

    private string GetTrendIcon(string trend) => trend switch
    {
        "Up" => "↑",
        "Down" => "↓",
        _ => "→"
    };
}
