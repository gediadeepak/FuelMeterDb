@page "/monthly-statement"
@using FuelMeter.Core.DTOs
@using FuelMeter.Core.Services
@using FuelMeter.Core.Services.Interfaces
@layout MainLayout
@inject IMeterReadingService MeterService
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="stmt-page">
    <div class="stmt-header">
        <h1 class="stmt-title">
            <i data-lucide="file-text" class="stmt-icon-lg"></i>
            Monthly Statement
        </h1>
        <p class="stmt-subtitle">Generate a PDF statement for tax, landlord, or dispute purposes.</p>
    </div>

    <div class="stmt-card">
        <div class="stmt-controls">
            <div class="stmt-field">
                <label for="stmt-month">Month</label>
                <select id="stmt-month" class="stmt-select" @bind="_selectedMonth" @bind:after="LoadAsync">
                    @foreach (var m in _monthOptions)
                    {
                        <option value="@m.Value">@m.Label</option>
                    }
                </select>
            </div>
        </div>

        <div class="stmt-actions">
            <button class="stmt-btn stmt-btn-primary"
                    @onclick="DownloadPdfAsync"
                    disabled="@(_data is null || _busy)">
                <i data-lucide="download" class="stmt-icon"></i>
                <span>Download PDF</span>
            </button>
            <button class="stmt-btn"
                    @onclick="PrintAsync"
                    disabled="@(_data is null || _busy)">
                <i data-lucide="printer" class="stmt-icon"></i>
                <span>Print</span>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="stmt-status stmt-error">
                <i data-lucide="alert-triangle" class="stmt-icon"></i>
                <span>@_errorMsg</span>
            </div>
        }
    </div>

    @if (_loading)
    {
        <div class="stmt-loading">Loading statement…</div>
    }
    else if (_data is not null)
    {
        <div class="stmt-doc">
            <h2 class="stmt-doc-title">FuelMeter Monthly Statement</h2>
            <div class="stmt-meta">
                <div><span class="lbl">Account</span><span>@(AuthState.CurrentUser?.FullName ?? "-")</span></div>
                <div><span class="lbl">Email</span><span>@(AuthState.CurrentUser?.Email ?? "-")</span></div>
                <div><span class="lbl">Period</span><span>@_periodLabel</span></div>
                <div><span class="lbl">Generated</span><span>@DateTime.Now.ToString("dd MMM yyyy HH:mm")</span></div>
            </div>

            <h3 class="stmt-doc-sub">Summary</h3>

            <!-- Responsive list (mobile) -->
            <div class="stmt-rows">
                <div class="stmt-row-card">
                    <div class="stmt-row-head"><i data-lucide="zap" class="stmt-icon"></i> Electricity</div>
                    <div class="stmt-row-body">
                        <div><span class="lbl">Units Used</span><span>@_data.ElectricityUsage.ToString("N2")</span></div>
                        <div><span class="lbl">Estimated Cost</span><span>@_data.ElectricityCost.ToString("C")</span></div>
                    </div>
                </div>
                <div class="stmt-row-card">
                    <div class="stmt-row-head"><i data-lucide="flame" class="stmt-icon"></i> Gas</div>
                    <div class="stmt-row-body">
                        <div><span class="lbl">Units Used</span><span>@_data.GasUsage.ToString("N2")</span></div>
                        <div><span class="lbl">Estimated Cost</span><span>@_data.GasCost.ToString("C")</span></div>
                    </div>
                </div>
                <div class="stmt-row-card stmt-row-total">
                    <div class="stmt-row-head">Total</div>
                    <div class="stmt-row-body">
                        <div><span class="lbl">All fuels</span>
                            <span><strong>@((_data.ElectricityCost + _data.GasCost).ToString("C"))</strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="stmt-disclaimer">
                This statement is an estimate generated from meter readings recorded in FuelMeter
                and the user-provided tariff. Always confirm with your supplier's official bill.
            </p>
        </div>
    }
    else if (_error)
    {
        <div class="stmt-empty">⚠️ Could not load statement data for the selected month.</div>
    }
</div>

@code {
    private record MonthOption(string Value, string Label);

    private List<MonthOption> _monthOptions = Enumerable
        .Range(0, 12)
        .Select(i => DateTime.Today.AddMonths(-i))
        .Select(d => new MonthOption(d.ToString("yyyy-MM"), d.ToString("MMMM yyyy")))
        .ToList();

    private string _selectedMonth = DateTime.Today.ToString("yyyy-MM");
    private DashboardDto? _data;
    private bool _loading;
    private bool _error;
    private bool _busy;
    private string _periodLabel = "";
    private string? _errorMsg;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("lucide.createIcons"); } catch { }
    }

    private async Task LoadAsync()
    {
        if (!DateTime.TryParse(_selectedMonth + "-01", out var parsed)) return;

        _loading = true;
        _error = false;
        _errorMsg = null;
        _data = null;
        StateHasChanged();

        try
        {
            _data = await MeterService.GetDashboardAsync(
                AuthState.CurrentUser!.Id, parsed.Year, parsed.Month);
            _periodLabel = parsed.ToString("MMMM yyyy");
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMsg = ex.Message;
        }
        finally { _loading = false; }
    }

    private object BuildPayload() => new
    {
        account   = AuthState.CurrentUser?.FullName ?? "",
        email     = AuthState.CurrentUser?.Email ?? "",
        period    = _periodLabel,
        generated = DateTime.Now.ToString("dd MMM yyyy HH:mm"),
        currency  = _data?.CurrencySymbol ?? "£",
        electricity = new
        {
            usage = _data?.ElectricityUsage.ToString("N2") ?? "0",
            cost  = _data?.ElectricityCost.ToString("N2") ?? "0"
        },
        gas = new
        {
            usage = _data?.GasUsage.ToString("N2") ?? "0",
            cost  = _data?.GasCost.ToString("N2") ?? "0"
        },
        total = ((_data?.ElectricityCost ?? 0) + (_data?.GasCost ?? 0)).ToString("N2")
    };

    private async Task DownloadPdfAsync()
    {
        if (_data is null) return;
        _busy = true;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            var ok = await JS.InvokeAsync<bool>("fuelMeterStatement.downloadPdf",
                BuildPayload(), $"FuelMeter-Statement-{_selectedMonth}.pdf");
            if (!ok) _errorMsg = "Could not generate PDF. Please check your internet connection.";
        }
        catch (Exception ex)
        {
            _errorMsg = $"PDF error: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task PrintAsync()
    {
        if (_data is null) return;
        _busy = true;
        _errorMsg = null;
        StateHasChanged();
        try
        {
            var ok = await JS.InvokeAsync<bool>("fuelMeterStatement.print", BuildPayload());
            if (!ok) _errorMsg = "Could not open print window. Please allow pop-ups.";
        }
        catch (Exception ex)
        {
            _errorMsg = $"Print error: {ex.Message}";
        }
        finally { _busy = false; }
    }
}
