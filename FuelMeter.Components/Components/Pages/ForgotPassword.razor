@page "/forgot-password"
@using FuelMeter.Components.Models
@using FuelMeter.Core.DTOs
@using FuelMeter.Core.Services.Interfaces
@layout AuthLayout
@inject IAuthService AuthService

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="images/fuelMeter_Logo.png" alt="FuelMeter" />
            <span class="auth-logo-text">FuelMeter</span>
        </div>

        @if (!_emailSent)
        {
            <h2 class="auth-title">Forgot password?</h2>
            <p class="auth-subtitle">
                Enter the email address linked to your account and we'll send you a reset link.
            </p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="auth-alert auth-alert-error">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email">Email address</label>
                    <InputText id="email" class="form-control" @bind-Value="_model.Email"
                               placeholder="you@example.com" autocomplete="email" />
                    <ValidationMessage For="() => _model.Email" class="validation-message" />
                </div>

                <div class="button-row">
                    <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span>Sending…</span>
                        }
                        else
                        {
                            <span>Send reset link</span>
                        }
                    </button>
                    <a href="/login" class="btn btn-secondary">Back to Login</a>
                </div>
            </EditForm>
        }
        else
        {
            <div class="success-state">
                <div class="success-icon">✉️</div>
                <h2 class="auth-title">Check your inbox</h2>
                <p class="auth-subtitle">
                    We've sent a password reset link to <strong>@_model.Email</strong>.
                    Check your inbox and follow the instructions.
                </p>
                <p class="auth-subtitle resend-note">
                    Didn't receive it?
                    <button class="btn-link" @onclick="HandleResend">Resend email</button>
                </p>
                <div class="button-row">
                    <a href="/login" class="btn btn-primary">Back to Login</a>
                </div>
            </div>
        }

        <p class="auth-footer">
            Remember your password? <a href="/login">Sign in here</a>
        </p>

    </div>
</div>

@code {
    private readonly ForgotPasswordModel _model = new();
    private bool _isBusy;
    private bool _emailSent;
    private string _errorMessage = string.Empty;

    private async Task HandleSubmitAsync()
    {
        _isBusy = true;
        _errorMessage = string.Empty;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(new ForgotPasswordRequest
            {
                Email = _model.Email
            });

            // Always show success state (anti-enumeration — server always returns success)
            _emailSent = result.Success || !string.IsNullOrEmpty(result.Message);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void HandleResend()
    {
        _emailSent = false;
    }
}
