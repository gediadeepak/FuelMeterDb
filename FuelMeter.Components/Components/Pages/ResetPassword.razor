@page "/reset-password"
@using FuelMeter.Components.Models
@using FuelMeter.Core.Services.Interfaces
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="images/fuelMeter_Logo.png" alt="FuelMeter" />
            <span class="auth-logo-text">FuelMeter</span>
        </div>

        @if (_tokenMissing)
        {
            <div class="reset-invalid-state">
                <div class="success-icon">⚠️</div>
                <h2 class="auth-title">Invalid reset link</h2>
                <p class="auth-subtitle">
                    This password reset link is missing or malformed.
                    Please request a new one.
                </p>
                <div class="button-row">
                    <a href="/forgot-password" class="btn btn-primary">Request new link</a>
                    <a href="/login" class="btn btn-secondary">Back to Login</a>
                </div>
            </div>
        }
        else if (_resetSuccess)
        {
            <div class="success-state">
                <div class="success-icon">✅</div>
                <h2 class="auth-title">Password updated!</h2>
                <p class="auth-subtitle">
                    Your password has been reset successfully.
                    You can now sign in with your new password.
                </p>
                <div class="button-row">
                    <a href="/login" class="btn btn-primary">Sign in</a>
                </div>
            </div>
        }
        else
        {
            <h2 class="auth-title">Choose a new password</h2>
            <p class="auth-subtitle">
                Enter and confirm your new password below.
                It must be at least 8 characters.
            </p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="auth-alert auth-alert-error">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="ResetPasswordForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="password">New password</label>
                    <div class="password-wrapper">
                        <InputText id="password"
                                   type="@(_showPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind-Value="_model.Password"
                                   placeholder="Min. 8 characters"
                                   autocomplete="new-password" />
                        <button type="button" class="password-toggle"
                                @onclick="() => _showPassword = !_showPassword"
                                aria-label="Toggle password visibility">
                            @(_showPassword ? "🙈" : "👁️")
                        </button>
                    </div>
                    <ValidationMessage For="() => _model.Password" class="validation-message" />
                </div>

                <div class="form-group">
                    <label for="confirm">Confirm new password</label>
                    <div class="password-wrapper">
                        <InputText id="confirm"
                                   type="@(_showConfirm ? "text" : "password")"
                                   class="form-control"
                                   @bind-Value="_model.ConfirmPassword"
                                   placeholder="Repeat your password"
                                   autocomplete="new-password" />
                        <button type="button" class="password-toggle"
                                @onclick="() => _showConfirm = !_showConfirm"
                                aria-label="Toggle confirm visibility">
                            @(_showConfirm ? "🙈" : "👁️")
                        </button>
                    </div>
                    <ValidationMessage For="() => _model.ConfirmPassword" class="validation-message" />
                </div>

                <div class="button-row">
                    <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Saving…</span> }
                        else          { <span>Reset password</span> }
                    </button>
                    <a href="/login" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        }

        <p class="auth-footer">
            Remember your password? <a href="/login">Sign in here</a>
        </p>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordModel _model = new();
    private bool _isBusy;
    private bool _resetSuccess;
    private bool _tokenMissing;
    private bool _showPassword;
    private bool _showConfirm;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token))
            _tokenMissing = true;
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token)) { _tokenMissing = true; return; }

        _isBusy = true;
        _errorMessage = string.Empty;

        try
        {
            var result = await AuthService.ResetPasswordAsync(Token, _model.Password);

            if (result.Success)
            {
                _resetSuccess = true;
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
