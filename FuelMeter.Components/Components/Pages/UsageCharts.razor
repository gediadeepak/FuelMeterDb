@page "/usage-charts"
@using FuelMeter.Core.DTOs
@using FuelMeter.Core.Services
@using FuelMeter.Core.Services.Interfaces
@layout MainLayout
@inject IMeterReadingService MeterService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="charts-page">

    <div class="settings-header">
        <h1 class="settings-title">Usage Charts</h1>
        <p class="settings-subtitle">Electricity &amp; gas usage and cost visualised over time.</p>
    </div>

    <!-- ── Controls ── -->
    <div class="chart-controls">
        <!-- View toggle -->
        <div class="chart-view-tabs">
            @foreach (var v in new[] { "Daily", "Monthly", "Yearly" })
            {
                <button class="chart-tab @(_view == v ? "chart-tab-active" : "")"
                        @onclick="() => SetView(v)">@v</button>
            }
        </div>

        <!-- Year picker -->
        <div class="chart-control-group">
            <label>Year</label>
            <select class="form-control chart-select" @bind="_year" @bind:after="LoadAsync">
                @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>

        <!-- Month picker (Daily only) -->
        @if (_view == "Daily")
        {
            <div class="chart-control-group">
                <label>Month</label>
                <select class="form-control chart-select" @bind="_month" @bind:after="LoadAsync">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
        }

        <!-- Metric toggle -->
        <div class="chart-control-group">
            <label>Show</label>
            <select class="form-control chart-select" @bind="_metric">
                <option value="Usage">Usage</option>
                <option value="Cost">Cost</option>
            </select>
        </div>
    </div>

    @if (_loading)
    {
        <div class="settings-loading">Loading chart data…</div>
    }
    else if (_data is null || _data.Bars.Count == 0)
    {
        <div class="dash-no-readings">📭 No readings found for this period.</div>
    }
    else
    {
        <!-- ── Electricity Bar Chart ── -->
        <div class="chart-card chart-card-full">
            <div class="chart-card-header">
                <span class="chart-card-title blue">⚡ Electricity — @_metric
                    @(_metric == "Usage" ? "(kWh)" : $"({_data.CurrencySymbol})")</span>
                <span class="chart-card-total blue">
                    Total: @(_metric == "Usage"
                        ? _data.Bars.Sum(b => b.ElectricityUsage).ToString("N1") + " kWh"
                        : _data.CurrencySymbol + _data.Bars.Sum(b => b.ElectricityCost).ToString("N2"))
                </span>
            </div>
            @RenderBarChart(isElectricity: true)
        </div>

        <!-- ── Gas Bar Chart ── -->
        <div class="chart-card chart-card-full">
            <div class="chart-card-header">
                <span class="chart-card-title green">🔥 Gas — @_metric
                    @(_metric == "Usage" ? "(units)" : $"({_data.CurrencySymbol})")</span>
                <span class="chart-card-total green">
                    Total: @(_metric == "Usage"
                        ? _data.Bars.Sum(b => b.GasUsage).ToString("N1") + " units"
                        : _data.CurrencySymbol + _data.Bars.Sum(b => b.GasCost).ToString("N2"))
                </span>
            </div>
            @RenderBarChart(isElectricity: false)
        </div>

        <!-- ── Combined table ── -->
        <div class="chart-card chart-card-full">
            <div class="chart-card-header">
                <span class="chart-card-title">📋 Data Table</span>
            </div>
            <div class="chart-table-wrap">
                <table class="chart-table">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th class="blue">Elec Usage (kWh)</th>
                            <th class="blue">Elec Cost</th>
                            <th class="green">Gas Usage (units)</th>
                            <th class="green">Gas Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bar in _data.Bars)
                        {
                            <tr>
                                <td>@bar.Label</td>
                                <td class="blue">@bar.ElectricityUsage.ToString("N1")</td>
                                <td class="blue">@_data.CurrencySymbol@bar.ElectricityCost.ToString("N2")</td>
                                <td class="green">@bar.GasUsage.ToString("N1")</td>
                                <td class="green">@_data.CurrencySymbol@bar.GasCost.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private UsageChartDto? _data;
    private bool   _loading = true;
    private string _view    = "Monthly";
    private string _metric  = "Usage";
    private int    _year    = DateTime.Today.Year;
    private int    _month   = DateTime.Today.Month;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication before loading data
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private async Task SetView(string v)
    {
        _view = v;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!AuthState.IsAuthenticated) return;
        _loading = true;
        try
        {
            _data = await MeterService.GetUsageChartAsync(
                AuthState.CurrentUser!.Id, _view, _year,
                _view == "Daily" ? _month : null);
        }
        catch { _data = null; }
        finally { _loading = false; }
    }

    // ── Pure SVG bar chart renderer ──────────────────────────────
    private RenderFragment RenderBarChart(bool isElectricity) => __builder =>
    {
        if (_data is null || _data.Bars.Count == 0) return;

        const int svgW = 900, svgH = 220;
        const int padL = 48, padR = 10, padT = 10, padB = 36;
        int chartW = svgW - padL - padR;
        int chartH = svgH - padT - padB;

        var values = _metric == "Usage"
            ? _data.Bars.Select(b => isElectricity ? b.ElectricityUsage : b.GasUsage).ToList()
            : _data.Bars.Select(b => isElectricity ? b.ElectricityCost  : b.GasCost).ToList();

        decimal maxVal = values.Max();
        if (maxVal <= 0) maxVal = 1;

        int n       = _data.Bars.Count;
        double barW = Math.Max(4, (double)chartW / n * 0.6);
        double step  = (double)chartW / n;
        string color = isElectricity ? "var(--fm-blue)" : "#2E7D32";
        string colorLight = isElectricity ? "#E3EEFF" : "#E8F5E9";

        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "chart-svg-wrap");

        __builder.OpenElement(2, "svg");
        __builder.AddAttribute(3, "viewBox", $"0 0 {svgW} {svgH}");
        __builder.AddAttribute(4, "class", "chart-svg");
        __builder.AddAttribute(5, "preserveAspectRatio", "xMidYMid meet");

        // Gridlines (4 horizontal)
        for (int g = 0; g <= 4; g++)
        {
            double gy = padT + chartH - (chartH * g / 4.0);
            decimal gVal = maxVal * g / 4;

            __builder.OpenElement(6 + g * 3, "line");
            __builder.AddAttribute(7 + g * 3, "x1", padL);
            __builder.AddAttribute(8 + g * 3, "y1", gy.ToString("F1"));
            __builder.AddAttribute(9 + g * 3, "x2", svgW - padR);
            __builder.AddAttribute(10 + g * 3, "y2", gy.ToString("F1"));
            __builder.AddAttribute(11 + g * 3, "stroke", colorLight);
            __builder.AddAttribute(12 + g * 3, "stroke-width", "1");
            __builder.CloseElement();

            __builder.OpenElement(20 + g * 2, "text");
            __builder.AddAttribute(21 + g * 2, "x", padL - 4);
            __builder.AddAttribute(22 + g * 2, "y", (gy + 4).ToString("F1"));
            __builder.AddAttribute(23 + g * 2, "class", "chart-axis-label");
            __builder.AddAttribute(24 + g * 2, "text-anchor", "end");
            __builder.AddContent(25 + g * 2, gVal > 999 ? $"{gVal / 1000:N1}k" : gVal.ToString("N0"));
            __builder.CloseElement();
        }

        // Bars
        for (int i = 0; i < n; i++)
        {
            double val    = (double)values[i];
            double barH   = val <= 0 ? 1 : chartH * val / (double)maxVal;
            double x      = padL + i * step + (step - barW) / 2;
            double y      = padT + chartH - barH;
            string label  = _data.Bars[i].Label;

            int seq = 100 + i * 10;

            __builder.OpenElement(seq, "rect");
            __builder.AddAttribute(seq+1, "x",      x.ToString("F1"));
            __builder.AddAttribute(seq+2, "y",      y.ToString("F1"));
            __builder.AddAttribute(seq+3, "width",  barW.ToString("F1"));
            __builder.AddAttribute(seq+4, "height", barH.ToString("F1"));
            __builder.AddAttribute(seq+5, "rx",     "3");
            __builder.AddAttribute(seq+6, "fill",   color);
            __builder.AddAttribute(seq+7, "opacity", "0.85");
            __builder.CloseElement();

            // Value label on bar (only if bar is tall enough)
            if (barH > 18)
            {
                __builder.OpenElement(seq+8, "text");
                __builder.AddAttribute(seq+9,  "x",           (x + barW / 2).ToString("F1"));
                __builder.AddAttribute(seq+10, "y",           (y + 13).ToString("F1"));
                __builder.AddAttribute(seq+11, "class",       "chart-bar-label");
                __builder.AddAttribute(seq+12, "text-anchor", "middle");
                __builder.AddContent(seq+13, val > 999 ? $"{val/1000:N1}k" : val.ToString("N1"));
                __builder.CloseElement();
            }

            // X-axis label
            __builder.OpenElement(seq+14, "text");
            __builder.AddAttribute(seq+15, "x",           (x + barW / 2).ToString("F1"));
            __builder.AddAttribute(seq+16, "y",           (svgH - padB + 16).ToString("F1"));
            __builder.AddAttribute(seq+17, "class",       "chart-axis-label");
            __builder.AddAttribute(seq+18, "text-anchor", "middle");
            __builder.AddContent(seq+19, label);
            __builder.CloseElement();
        }

        __builder.CloseElement(); // </svg>
        __builder.CloseElement(); // </div>
    };
}
