@page "/usage-charts"
@layout MainLayout
@inject IMeterReadingService MeterService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="charts-page">
    <div class="settings-header">
        <h1 class="settings-title">Usage charts</h1>
    </div>

    <div class="chart-controls">
        <div class="chart-view-tabs" aria-label="Chart period">
            @foreach (var view in new[] { "Daily", "Monthly", "Yearly" })
            {
                <button type="button" class="chart-tab @(_view == view ? "chart-tab-active" : "")"
                        aria-pressed="@(_view == view ? "true" : "false")"
                        @onclick="() => SetViewAsync(view)">@view</button>
            }
        </div>

        <div class="chart-control-group">
            <label for="chart-year">Year</label>
            <select id="chart-year" class="form-control chart-select" @bind="_year" @bind:after="LoadAsync">
                @for (var year = DateTime.Today.Year; year >= DateTime.Today.Year - 4; year--)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>

        @if (_view == "Daily")
        {
            <div class="chart-control-group">
                <label for="chart-month">Month</label>
                <select id="chart-month" class="form-control chart-select" @bind="_month" @bind:after="LoadAsync">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@(new DateTime(2000, month, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
        }

        <div class="chart-control-group">
            <label for="chart-metric">Show</label>
            <select id="chart-metric" class="form-control chart-select" @bind="_metric" @bind:after="ChangeMetricAsync">
                <option value="Usage">Usage</option>
                <option value="Cost">Usage charges</option>
                <option value="Spending">Monthly spending vs budget</option>
            </select>
        </div>
    </div>

    @if (_loading)
    {
        <p class="settings-loading" role="status">Loading chart data…</p>
    }
    else if (_error)
    {
        <div class="dash-no-readings" role="alert">
            <p>FuelMeter could not load the chart data.</p>
            <button type="button" class="btn btn-outline-primary" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (_data is null || _data.Bars.Count == 0)
    {
        <p class="dash-no-readings">No readings found for this period.</p>
    }
    else if (IsSpending && _data.Bars.All(bar => bar.ElectricityStandingCost is null))
    {
        <p class="dash-no-readings">Monthly spending details are unavailable.</p>
    }
    else
    {
        @if (ShowIntervals)
        {
            <p class="settings-subtitle">Each bar totals usage between two readings. The last reading determines which month the interval appears in.</p>
        }
        @if (IsSpending)
        {
            <p class="settings-subtitle">Estimates use your saved tariff and include standing charges for the full month. Future months show any budget you’ve set.</p>
        }

        @foreach (var electricity in new[] { true, false })
        {
            var fuel = electricity ? "Electricity" : "Gas";
            var points = GetPoints(electricity);
            var color = electricity ? "#185fad" : "#27713a";
            var title = $"{fuel} · {MetricLabel}";
            <section class="chart-card chart-card-full" aria-label="@title">
                <div class="chart-card-header">
                    <h2 class="chart-card-title">@title (@(IsUsage ? UsageUnit(electricity) : _data.CurrencySymbol))</h2>
                    @if (points.Count > 0)
                    {
                        <span class="chart-card-total">Total @FormatValue(points.Sum(point => point.Value + point.Standing), electricity)</span>
                    }
                </div>
                @if (IsSpending)
                {
                    <div class="usage-graph-legend" style="--graph-accent: @color">
                        <span><i aria-hidden="true"></i> Usage charges</span>
                        <span><i class="standing" aria-hidden="true"></i> Standing charges</span>
                        <span><i class="budget" aria-hidden="true"></i> Budget</span>
                    </div>
                }
                <UsageGraph @key="(_data, electricity, _metric)" Points="points" Title="@title" Color="@color" />
            </section>
        }

        <details class="chart-card chart-card-full">
            <summary class="chart-card-title">Data table</summary>
            <div class="chart-table-wrap">
                <table class="chart-table">
                    <thead>
                        <tr>
                            <th scope="col">Period</th>
                            <th scope="col">Electricity</th>
                            <th scope="col">Gas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bar in _data.Bars)
                        {
                            if (ShowIntervals && bar.ElectricityReadingFrom is null && bar.GasReadingFrom is null)
                                continue;

                            <tr>
                                <th scope="row">@(bar.ReadingDate?.ToString("d MMM") ?? bar.Label)</th>
                                <td>@TableValue(bar, true)</td>
                                <td>@TableValue(bar, false)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</div>

@code {
    private UsageChartDto? _data;
    private bool _loading = true;
    private bool _error;
    private string _view = "Monthly";
    private string _metric = "Usage";
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private int _request;

    private bool IsSpending => _metric == "Spending";
    private bool IsUsage => _metric == "Usage";
    private bool ShowIntervals => _view == "Daily" && _data?.HasReadingIntervals == true;
    private string MetricLabel => _metric switch
    {
        "Spending" => "Estimated spending",
        "Cost" => "Usage charges",
        _ => "Usage"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private Task SetViewAsync(string view)
    {
        _view = view;
        if (view != "Monthly" && IsSpending)
            _metric = "Cost";

        return LoadAsync();
    }

    private Task ChangeMetricAsync() => IsSpending && _view != "Monthly"
        ? SetViewAsync("Monthly")
        : Task.CompletedTask;

    private async Task LoadAsync()
    {
        if (AuthState.CurrentUser is not { } user)
            return;

        var request = ++_request;
        _loading = true;
        _error = false;
        try
        {
            var data = await MeterService.GetUsageChartAsync(user.Id, _view, _year, _view == "Daily" ? _month : null);
            if (request == _request)
                _data = data;
        }
        catch (Exception)
        {
            if (request == _request)
                _error = true;
        }
        finally
        {
            if (request == _request)
                _loading = false;
        }
    }

    private List<UsageGraph.Point> GetPoints(bool electricity) =>
        _data!.Bars.Where(bar => !ShowIntervals || ReadingFrom(bar, electricity).HasValue)
            .Select(bar =>
            {
                var value = Value(bar, electricity);
                var standing = Standing(bar, electricity);
                var budget = IsSpending ? (electricity ? bar.ElectricityBudget : bar.GasBudget) ?? 0 : 0;
                var period = Period(bar, electricity);
                var detail = $"{period} · {FormatValue(value + standing, electricity)}";
                if (IsSpending)
                {
                    detail += $" estimated total · {FormatValue(value, electricity)} usage · {FormatValue(standing, electricity)} standing";
                    if (budget > 0)
                        detail += $" · {FormatValue(budget, electricity)} budget";
                }
                else if (IsUsage)
                {
                    var cost = electricity ? bar.ElectricityCost : bar.GasCost;
                    detail += $" · {_data.CurrencySymbol}{cost:N2} usage charges";
                }

                var label = bar.Label;
                if (ShowIntervals && bar.ReadingDate is { } end && ReadingFrom(bar, electricity) is { } start)
                {
                    if (start == end)
                        label = end.ToString("d MMM");
                    else if (start.Month == end.Month && start.Year == end.Year)
                        label = $"{start.Day}–{end.Day}";
                    else
                        label = $"{end:d MMM}";
                }

                return new UsageGraph.Point(label, value, detail, standing, budget);
            }).ToList();

    private string TableValue(ChartBarDto bar, bool electricity)
    {
        if (ShowIntervals && !ReadingFrom(bar, electricity).HasValue)
            return "—";

        var usage = electricity ? bar.ElectricityUsage : bar.GasUsage;
        var cost = electricity ? bar.ElectricityCost : bar.GasCost;
        var currency = _data!.CurrencySymbol;
        if (IsSpending)
        {
            var standing = Standing(bar, electricity);
            var budget = electricity ? bar.ElectricityBudget : bar.GasBudget;
            var breakdown = $"{currency}{cost + standing:N2} total ({currency}{cost:N2} usage + {currency}{standing:N2} standing)";
            return budget is > 0 ? $"{breakdown} · {currency}{budget:N2} budget" : breakdown;
        }

        var value = $"{usage:N2} {UsageUnit(electricity)} · {currency}{cost:N2}";
        return ShowIntervals ? $"{value} ({Period(bar, electricity)})" : value;
    }

    private string Period(ChartBarDto bar, bool electricity)
    {
        if (ShowIntervals && bar.ReadingDate is { } end && ReadingFrom(bar, electricity) is { } start)
            return start == end ? end.ToString("d MMM yyyy") : $"{start:d MMM yyyy} to {end:d MMM yyyy}";

        return _view == "Monthly" ? $"{bar.Label} {_year}" : bar.Label;
    }

    private static DateTime? ReadingFrom(ChartBarDto bar, bool electricity) =>
        electricity ? bar.ElectricityReadingFrom : bar.GasReadingFrom;

    private decimal Value(ChartBarDto bar, bool electricity) => IsUsage
        ? (electricity ? bar.ElectricityUsage : bar.GasUsage)
        : (electricity ? bar.ElectricityCost : bar.GasCost);

    private decimal Standing(ChartBarDto bar, bool electricity) =>
        IsSpending ? (electricity ? bar.ElectricityStandingCost : bar.GasStandingCost) ?? 0 : 0;

    private static string UsageUnit(bool electricity) => electricity ? "kWh" : "units";

    private string FormatValue(decimal value, bool electricity) =>
        IsUsage ? $"{value:N2} {UsageUnit(electricity)}" : $"{_data!.CurrencySymbol}{value:N2}";
}
