@page "/budget-management"
@using FuelMeter.Core.DTOs
@using FuelMeter.Core.Services
@using FuelMeter.Core.Services.Interfaces
@layout MainLayout
@inject IBudgetService BudgetService
@inject IBillEstimationService BillService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="budget-management">
    <div class="page-header">
        <div>
            <h1>Budget Management</h1>
            <p class="subtitle">Set and track your monthly fuel budgets</p>
        </div>
        <button class="btn-primary" @onclick="ShowCreateDialog">+ New Budget</button>
    </div>

    @if (_loading)
    {
        <div class="loading-message">Loading budgets...</div>
    }
    else
    {
        <!-- Year Selector -->
        <div class="year-selector">
            <button class="btn-nav" @onclick="PreviousYear">←</button>
            <span class="year-display">@_selectedYear</span>
            <button class="btn-nav" @onclick="NextYear">→</button>
        </div>

        <!-- Budget Status Cards -->
        <div class="budget-grid">
            @foreach (var status in _monthlyStatuses.Where(s => s.HasBudget))
            {
                <div class="budget-card @GetBudgetCardClass(status)">
                    <div class="budget-header">
                        <span class="fuel-icon">@(status.FuelType == "Electricity" ? "⚡" : "🔥")</span>
                        <span class="fuel-type">@status.FuelType</span>
                        <span class="month-label">@GetMonthName(status.Month)</span>
                    </div>
                    <div class="budget-details">
                        <div class="budget-row">
                            <span class="label">Budget:</span>
                            <span class="value">£@status.BudgetLimit?.ToString("N2")</span>
                        </div>
                        <div class="budget-row">
                            <span class="label">Spent:</span>
                            <span class="value">£@status.ActualSpent.ToString("N2")</span>
                        </div>
                        @if (status.RemainingBudget.HasValue)
                        {
                            <div class="budget-row">
                                <span class="label">Remaining:</span>
                                <span class="value @(status.IsOverBudget ? "over-budget" : "")">
                                    £@status.RemainingBudget.Value.ToString("N2")
                                </span>
                            </div>
                        }
                        @if (status.PercentageUsed.HasValue)
                        {
                            <div class="progress-bar">
                                <div class="progress-fill @(status.IsOverBudget ? "over" : "")" 
                                     style="width: @Math.Min(status.PercentageUsed.Value, 100)%"></div>
                            </div>
                            <div class="percentage">@status.PercentageUsed.Value.ToString("N0")% Used</div>
                        }
                    </div>
                    <div class="budget-actions">
                        <button class="btn-edit" @onclick="() => EditBudget(status)">Edit</button>
                        <button class="btn-delete" @onclick="() => DeleteBudget(status)">Delete</button>
                    </div>
                </div>
            }
        </div>

        @if (!_monthlyStatuses.Any(s => s.HasBudget))
        {
            <div class="empty-state">
                <p>📊 No budgets set for @_selectedYear</p>
                <p>Create your first budget to start tracking your spending</p>
            </div>
        }

        <!-- Over Budget Alerts -->
        @if (_overBudgetAlerts.Any())
        {
            <div class="alerts-section">
                <h2>⚠️ Over Budget Alerts</h2>
                <div class="alerts-list">
                    @foreach (var alert in _overBudgetAlerts)
                    {
                        <div class="alert-card">
                            <span class="alert-fuel">@alert.FuelType</span>
                            <span class="alert-month">@GetMonthName(alert.Month) @alert.Year</span>
                            <span class="alert-amount">Over by £@Math.Abs(alert.RemainingBudget).ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Create/Edit Dialog -->
@if (_showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h2>@(_isEditing ? "Edit Budget" : "Create Budget")</h2>
            <div class="form-group">
                <label>Fuel Type</label>
                <select @bind="_dialogBudget.FuelType" disabled="@_isEditing">
                    <option value="Electricity">⚡ Electricity</option>
                    <option value="Gas">🔥 Gas</option>
                </select>
            </div>
            <div class="form-group">
                <label>Year</label>
                <input type="number" @bind="_dialogBudget.Year" disabled="@_isEditing" />
            </div>
            <div class="form-group">
                <label>Month</label>
                <select @bind="_dialogBudget.Month" disabled="@_isEditing">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">@GetMonthName(i)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Budget Limit (£)</label>
                <input type="number" step="0.01" @bind="_dialogBudget.BudgetLimit" />
            </div>
            <div class="form-group">
                <label>Notes (optional)</label>
                <textarea @bind="_dialogBudget.Notes" rows="3"></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseDialog">Cancel</button>
                <button class="btn-primary" @onclick="SaveBudget">@(_isEditing ? "Update" : "Create")</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _selectedYear = DateTime.UtcNow.Year;
    private List<MonthlyBudgetStatusDto> _monthlyStatuses = new();
    private List<BudgetSummaryDto> _overBudgetAlerts = new();

    private bool _showDialog = false;
    private bool _isEditing = false;
    private DialogBudgetModel _dialogBudget = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication before loading data
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var userId = AuthState.CurrentUser?.Id ?? 0;
            _monthlyStatuses = await BudgetService.GetMonthlyBudgetStatusAsync(userId, _selectedYear);
            _overBudgetAlerts = await BudgetService.GetOverBudgetAlertsAsync(userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading budgets: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousYear()
    {
        _selectedYear--;
        _ = LoadDataAsync();
    }

    private void NextYear()
    {
        _selectedYear++;
        _ = LoadDataAsync();
    }

    private void ShowCreateDialog()
    {
        _isEditing = false;
        _dialogBudget = new DialogBudgetModel
        {
            Year = _selectedYear,
            Month = DateTime.UtcNow.Month,
            FuelType = "Electricity",
            BudgetLimit = 0
        };
        _showDialog = true;
    }

    private async void EditBudget(MonthlyBudgetStatusDto status)
    {
        _isEditing = true;
        var budget = await BudgetService.GetBudgetForMonthAsync(
            AuthState.CurrentUser?.Id ?? 0,
            status.FuelType,
            status.Year,
            status.Month
        );

        if (budget != null)
        {
            _dialogBudget = new DialogBudgetModel
            {
                Id = budget.Id,
                FuelType = budget.FuelType,
                Year = budget.Year,
                Month = budget.Month,
                BudgetLimit = budget.BudgetLimit,
                Notes = budget.Notes
            };
            _showDialog = true;
            StateHasChanged();
        }
    }

    private async void DeleteBudget(MonthlyBudgetStatusDto status)
    {
        var budget = await BudgetService.GetBudgetForMonthAsync(
            AuthState.CurrentUser?.Id ?? 0,
            status.FuelType,
            status.Year,
            status.Month
        );

        if (budget != null)
        {
            var success = await BudgetService.DeleteBudgetAsync(budget.Id, AuthState.CurrentUser?.Id ?? 0);
            if (success)
            {
                await LoadDataAsync();
                StateHasChanged();
            }
        }
    }

    private async Task SaveBudget()
    {
        try
        {
            var userId = AuthState.CurrentUser?.Id ?? 0;

            if (_isEditing)
            {
                var updateDto = new UpdateBudgetDto(_dialogBudget.BudgetLimit, _dialogBudget.Notes);
                await BudgetService.UpdateBudgetAsync(_dialogBudget.Id, userId, updateDto);
            }
            else
            {
                var createDto = new CreateBudgetDto(
                    _dialogBudget.FuelType,
                    _dialogBudget.Year,
                    _dialogBudget.Month,
                    _dialogBudget.BudgetLimit,
                    _dialogBudget.Notes
                );
                await BudgetService.CreateBudgetAsync(userId, createDto);
            }

            CloseDialog();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving budget: {ex.Message}");
        }
    }

    private void CloseDialog()
    {
        _showDialog = false;
        _dialogBudget = new();
    }

    private string GetBudgetCardClass(MonthlyBudgetStatusDto status)
    {
        if (status.IsOverBudget) return "over-budget";
        if (status.PercentageUsed > 80) return "warning";
        return "";
    }

    private string GetMonthName(int month) => new DateTime(2000, month, 1).ToString("MMMM");

    private class DialogBudgetModel
    {
        public int Id { get; set; }
        public string FuelType { get; set; } = "Electricity";
        public int Year { get; set; }
        public int Month { get; set; }
        public decimal BudgetLimit { get; set; }
        public string? Notes { get; set; }
    }
}

<style>
    .budget-management { padding: 2rem; max-width: 1400px; margin: 0 auto; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-header h1 { margin: 0; font-size: 2rem; }
    .subtitle { color: #666; margin-top: 0.5rem; }
    .year-selector { display: flex; align-items: center; justify-content: center; gap: 2rem; margin-bottom: 2rem; }
    .year-display { font-size: 1.5rem; font-weight: 600; min-width: 100px; text-align: center; }
    .btn-nav { padding: 0.5rem 1rem; border: 1px solid #ddd; background: white; border-radius: 4px; cursor: pointer; }
    .btn-nav:hover { background: #f5f5f5; }
    .budget-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .budget-card { border: 2px solid #e0e0e0; border-radius: 8px; padding: 1.5rem; background: white; }
    .budget-card.warning { border-color: #ff9800; background: #fff8e1; }
    .budget-card.over-budget { border-color: #f44336; background: #ffebee; }
    .budget-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; font-weight: 600; }
    .fuel-icon { font-size: 1.5rem; }
    .fuel-type { flex: 1; }
    .month-label { color: #666; font-size: 0.9rem; }
    .budget-details { margin-bottom: 1rem; }
    .budget-row { display: flex; justify-content: space-between; margin-bottom: 0.5rem; }
    .budget-row .label { color: #666; }
    .budget-row .value.over-budget { color: #f44336; font-weight: 600; }
    .progress-bar { height: 8px; background: #e0e0e0; border-radius: 4px; overflow: hidden; margin: 1rem 0 0.5rem; }
    .progress-fill { height: 100%; background: #4caf50; transition: width 0.3s; }
    .progress-fill.over { background: #f44336; }
    .percentage { text-align: center; font-size: 0.9rem; color: #666; }
    .budget-actions { display: flex; gap: 0.5rem; }
    .btn-edit, .btn-delete { flex: 1; padding: 0.5rem; border: 1px solid #ddd; background: white; border-radius: 4px; cursor: pointer; }
    .btn-edit:hover { background: #e3f2fd; }
    .btn-delete:hover { background: #ffebee; color: #f44336; }
    .empty-state { text-align: center; padding: 3rem; color: #666; }
    .alerts-section { margin-top: 2rem; }
    .alerts-section h2 { margin-bottom: 1rem; color: #f44336; }
    .alerts-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .alert-card { display: flex; justify-content: space-between; padding: 1rem; background: #ffebee; border-left: 4px solid #f44336; border-radius: 4px; }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal-content { background: white; border-radius: 8px; padding: 2rem; min-width: 400px; max-width: 90%; }
    .modal-content h2 { margin-top: 0; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.5rem; font-weight: 500; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; }
    .modal-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn-primary { padding: 0.75rem 1.5rem; background: #1976d2; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .btn-primary:hover { background: #1565c0; }
    .btn-secondary { padding: 0.75rem 1.5rem; background: #f5f5f5; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; }
    .btn-secondary:hover { background: #e0e0e0; }
    .loading-message { text-align: center; padding: 3rem; color: #666; }
</style>
