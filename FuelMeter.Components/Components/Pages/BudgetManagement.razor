@page "/budget-management"
@layout MainLayout
@using System.Globalization
@using System.Net
@inject IBudgetService BudgetService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="budget-page">
    <header class="budget-toolbar">
        <div>
            <h1>Budgets</h1>
            <p>Set monthly spending limits for electricity and gas.</p>
        </div>
        <button type="button" class="budget-button primary" @onclick="OpenCreate" disabled="@Busy">Add budget</button>
    </header>

    <div class="budget-year" aria-label="Budget year">
        <button type="button" class="budget-button" aria-label="Previous year"
                disabled="@(Busy || _selectedYear <= 1)" @onclick="() => ChangeYearAsync(-1)">‹</button>
        <strong aria-live="polite">@_selectedYear</strong>
        <button type="button" class="budget-button" aria-label="Next year"
                disabled="@(Busy || _selectedYear >= 9998)" @onclick="() => ChangeYearAsync(1)">›</button>
    </div>

    @if (_pageMessage is not null)
    {
        <p class="budget-feedback error" role="alert">@_pageMessage</p>
    }

    @if (_loading)
    {
        <p class="budget-empty" role="status">Loading budgets…</p>
    }
    else if (_loadFailed)
    {
        <button type="button" class="budget-button" @onclick="LoadDataAsync">Try again</button>
    }
    else if (_monthlyStatuses.Count == 0)
    {
        <div class="budget-empty">
            <h2>No budgets for @_selectedYear</h2>
            <p>Add a budget to track your spending against a monthly limit.</p>
        </div>
    }
    else
    {
        <div class="budget-grid">
            @foreach (var status in _monthlyStatuses)
            {
                <article class="budget-card @(status.IsOverBudget ? "over-budget" : "")" @key="(status.FuelType, status.Year, status.Month)">
                    <header class="budget-card-heading">
                        <h2>@status.FuelType</h2>
                        <span>@GetMonthName(status.Month)</span>
                    </header>
                    <dl class="budget-values">
                        <div><dt>Limit</dt><dd>@status.BudgetLimit?.ToString("C2", UkCurrency)</dd></div>
                        <div><dt>Spent</dt><dd>@status.ActualSpent.ToString("C2", UkCurrency)</dd></div>
                        @if (status.RemainingBudget is { } remaining)
                        {
                            <div class="budget-remaining">
                                <dt>@(status.IsOverBudget ? "Over budget" : "Remaining")</dt>
                                <dd>@Math.Abs(remaining).ToString("C2", UkCurrency)</dd>
                            </div>
                        }
                    </dl>
                    @if (status.PercentageUsed is { } percentage)
                    {
                        <progress class="budget-progress" max="100" value="@Math.Clamp(percentage, 0, 100).ToString(CultureInfo.InvariantCulture)"
                                  aria-label="Percentage of budget used"></progress>
                        <p class="budget-percent">@percentage.ToString("N0")% used</p>
                    }
                    <div class="budget-actions">
                        <button type="button" class="budget-button" @onclick="() => OpenEditAsync(status)" disabled="@Busy">Edit</button>
                        <button type="button" class="budget-button danger" @onclick="() => OpenDelete(status)" disabled="@Busy">Delete</button>
                    </div>
                </article>
            }
        </div>
    }

    @if (_overBudgetAlerts.Count > 0)
    {
        <section class="budget-alerts" aria-labelledby="budget-alerts-heading">
            <h2 id="budget-alerts-heading">Over budget</h2>
            @foreach (var alert in _overBudgetAlerts)
            {
                <div class="budget-alert">
                    <span>@alert.FuelType · @GetMonthName(alert.Month) @alert.Year</span>
                    <strong>Over by @Math.Abs(alert.RemainingBudget).ToString("C2", UkCurrency)</strong>
                </div>
            }
        </section>
    }
</div>

@if (_dialog is not null || _deleteTarget is not null)
{
    <div class="budget-overlay" @onclick="CloseDialog">
        <section class="budget-dialog" role="dialog" aria-modal="true" aria-labelledby="budget-dialog-title" @onclick:stopPropagation="true">
            @if (_dialog is { } budget)
            {
                <h2 id="budget-dialog-title">@(budget.Id == 0 ? "Add budget" : "Edit budget")</h2>
                <div class="budget-form">
                    <div class="budget-field">
                        <label for="budget-fuel">Fuel type</label>
                        <select id="budget-fuel" @bind="budget.FuelType" disabled="@(_working || budget.Id != 0)">
                            <option value="Electricity">Electricity</option>
                            <option value="Gas">Gas</option>
                        </select>
                    </div>
                    <div class="budget-period">
                        <div class="budget-field">
                            <label for="budget-month">Month</label>
                            <select id="budget-month" @bind="budget.Month" disabled="@(_working || budget.Id != 0)">
                                @for (var month = 1; month <= 12; month++)
                                {
                                    <option value="@month">@GetMonthName(month)</option>
                                }
                            </select>
                        </div>
                        <div class="budget-field">
                            <label for="budget-year">Year</label>
                            <input id="budget-year" type="number" min="1" max="9998" @bind="budget.Year" disabled="@(_working || budget.Id != 0)" />
                        </div>
                    </div>
                    <div class="budget-field">
                        <label for="budget-limit">Budget limit (£)</label>
                        <input id="budget-limit" type="number" min="0.01" step="0.01" inputmode="decimal" @bind="budget.Limit" disabled="@_working" />
                    </div>
                    <div class="budget-field">
                        <label for="budget-notes">Notes (optional)</label>
                        <textarea id="budget-notes" maxlength="500" rows="3" @bind="budget.Notes" disabled="@_working"></textarea>
                    </div>
                </div>
            }
            else if (_deleteTarget is { } target)
            {
                <h2 id="budget-dialog-title">Delete budget?</h2>
                <p>Remove the @target.FuelType.ToLowerInvariant() budget for @GetMonthName(target.Month) @target.Year.</p>
            }

            @if (_dialogMessage is not null)
            {
                <p class="budget-feedback error" role="alert">@_dialogMessage</p>
            }

            <div class="budget-actions">
                <button type="button" class="budget-button" @onclick="CloseDialog" disabled="@_working">Cancel</button>
                @if (_dialog is not null)
                {
                    <button type="button" class="budget-button primary" @onclick="SaveBudgetAsync" disabled="@_working">
                        @(_working ? "Saving…" : "Save budget")
                    </button>
                }
                else
                {
                    <button type="button" class="budget-button danger" @onclick="DeleteBudgetAsync" disabled="@_working">
                        @(_working ? "Deleting…" : "Delete budget")
                    </button>
                }
            </div>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo UkCurrency = CultureInfo.GetCultureInfo("en-GB");
    private bool _loading = true;
    private bool _loadFailed;
    private bool _working;
    private int _selectedYear = DateTime.Today.Year;
    private List<MonthlyBudgetStatusDto> _monthlyStatuses = [];
    private List<BudgetSummaryDto> _overBudgetAlerts = [];
    private BudgetEditor? _dialog;
    private MonthlyBudgetStatusDto? _deleteTarget;
    private string? _pageMessage;
    private string? _dialogMessage;

    private bool Busy => _loading || _working;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _loadFailed = false;
        _pageMessage = null;
        _monthlyStatuses = [];
        _overBudgetAlerts = [];
        try
        {
            var userId = AuthState.CurrentUser?.Id ?? 0;
            var statuses = await BudgetService.GetMonthlyBudgetStatusAsync(userId, _selectedYear);
            _monthlyStatuses = statuses.Where(status => status.HasBudget)
                .OrderBy(status => status.Month).ThenBy(status => status.FuelType).ToList();
            _overBudgetAlerts = await BudgetService.GetOverBudgetAlertsAsync(userId);
        }
        catch (Exception ex)
        {
            _loadFailed = _monthlyStatuses.Count == 0;
            _pageMessage = GetError(ex, _loadFailed ? "Could not load budgets. Try again." : "Could not load budget alerts.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangeYearAsync(int offset)
    {
        if (Busy || _selectedYear + offset is < 1 or > 9998)
            return;

        _selectedYear += offset;
        await LoadDataAsync();
    }

    private void OpenCreate()
    {
        _dialogMessage = null;
        _dialog = new() { Year = _selectedYear, Month = DateTime.Today.Month };
    }

    private async Task OpenEditAsync(MonthlyBudgetStatusDto status)
    {
        if (Busy || AuthState.CurrentUser is not { } user)
            return;

        _working = true;
        _pageMessage = null;
        _dialogMessage = null;
        try
        {
            var budget = await BudgetService.GetBudgetForMonthAsync(user.Id, status.FuelType, status.Year, status.Month);
            if (budget is null)
            {
                _pageMessage = "This budget is unavailable. Reload the page and try again.";
                return;
            }

            _dialog = new()
            {
                Id = budget.Id, FuelType = budget.FuelType, Year = budget.Year,
                Month = budget.Month, Limit = budget.BudgetLimit, Notes = budget.Notes
            };
        }
        catch (Exception ex)
        {
            _pageMessage = GetError(ex, "Could not open the budget. Try again.");
        }
        finally
        {
            _working = false;
        }
    }

    private void OpenDelete(MonthlyBudgetStatusDto status)
    {
        _dialogMessage = null;
        _deleteTarget = status;
    }

    private async Task SaveBudgetAsync()
    {
        if (_working || _dialog is not { } budget || AuthState.CurrentUser is not { } user)
            return;

        if (budget.Year is < 1 or > 9998 || budget.Month is < 1 or > 12 ||
            budget.FuelType is not ("Electricity" or "Gas"))
        {
            _dialogMessage = "Choose a valid fuel type, month and year.";
            return;
        }

        if (budget.Limit is not { } limit || limit is < 0.01m or > 9999999999999999.99m || decimal.Round(limit, 2) != limit)
        {
            _dialogMessage = "Enter a budget limit greater than zero, with up to two decimal places.";
            return;
        }

        _working = true;
        _dialogMessage = null;
        try
        {
            var notes = string.IsNullOrWhiteSpace(budget.Notes) ? null : budget.Notes.Trim();
            if (budget.Id == 0)
                await BudgetService.CreateBudgetAsync(user.Id, new(budget.FuelType, budget.Year, budget.Month, limit, notes));
            else if (await BudgetService.UpdateBudgetAsync(budget.Id, user.Id, new(limit, notes)) is null)
            {
                _dialogMessage = "This budget is unavailable. Reload the page and try again.";
                return;
            }

            _selectedYear = budget.Year;
            _dialog = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _dialogMessage = GetError(ex, "Could not save the budget. Try again.");
        }
        finally
        {
            _working = false;
        }
    }

    private async Task DeleteBudgetAsync()
    {
        if (_working || _deleteTarget is not { } target || AuthState.CurrentUser is not { } user)
            return;

        _working = true;
        _dialogMessage = null;
        try
        {
            var budget = await BudgetService.GetBudgetForMonthAsync(user.Id, target.FuelType, target.Year, target.Month);
            if (budget is not null)
                await BudgetService.DeleteBudgetAsync(budget.Id, user.Id);

            _deleteTarget = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _dialogMessage = GetError(ex, "Could not delete the budget. Try again.");
        }
        finally
        {
            _working = false;
        }
    }

    private void CloseDialog()
    {
        if (_working)
            return;

        _dialog = null;
        _deleteTarget = null;
        _dialogMessage = null;
    }

    private static string GetError(Exception ex, string fallback) => (ex as HttpRequestException)?.StatusCode switch
    {
        HttpStatusCode.Unauthorized => "Sign in again to manage budgets.",
        HttpStatusCode.Conflict => "A budget already exists for this fuel type and month.",
        HttpStatusCode.BadRequest => "Check the budget details and try again.",
        _ => fallback
    };

    private static string GetMonthName(int month) => UkCurrency.DateTimeFormat.GetMonthName(month);

    private sealed class BudgetEditor
    {
        public int Id { get; init; }
        public string FuelType { get; set; } = "Electricity";
        public int Year { get; set; }
        public int Month { get; set; }
        public decimal? Limit { get; set; }
        public string? Notes { get; set; }
    }
}
