@page "/scan-meter"
@implements IAsyncDisposable
@layout MainLayout
@inject IMeterReadingService MeterService
@inject IApiClientService Api
@inject IServiceProvider Services
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="scan-page">
    <div class="scan-header">
        <h1 class="scan-title">Add meter reading</h1>
    </div>

    <div class="scan-card">
        <div class="scan-tabs" role="tablist" aria-label="Meter reading method">
            @if (_subscription?.CanScan == true)
            {
            <button type="button" id="scan-automatic-tab" class="scan-tab" role="tab"
                    aria-selected="@(_automatic ? "true" : "false")" aria-controls="scan-automatic-panel"
                    tabindex="@(_automatic ? 0 : -1)" disabled="@IsBusy"
                    @ref="_automaticTab" @onclick="() => SelectTabAsync(true)" @onkeydown="HandleTabKeyAsync">
                Automatic
            </button>
            }
            <button type="button" id="scan-manual-tab" class="scan-tab" role="tab"
                    aria-selected="@(_automatic ? "false" : "true")" aria-controls="scan-manual-panel"
                    tabindex="@(_automatic ? -1 : 0)" disabled="@IsBusy"
                    @ref="_manualTab" @onclick="() => SelectTabAsync(false)" @onkeydown="HandleTabKeyAsync">
                Manual
            </button>
        </div>
        @if (_subscription?.PremiumAccessEnabled == true)
        {
            <p class="scan-hint"><a href="/subscription">Subscription and AI scan allowance</a></p>
        }

        <section id="scan-automatic-panel" class="scan-panel" role="tabpanel"
                 aria-labelledby="scan-automatic-tab" hidden="@(!_automatic)">
            <p class="scan-hint">Include the display and its unit (kWh, m³ or ft³). FuelMeter sends the photo to OpenAI to read the meter.</p>
            <div class="scan-capture">
                <button type="button" class="scan-btn scan-btn-primary" @onclick="OpenCameraAsync"
                        disabled="@(IsBusy || _cameraOpen)">
                    @(_nativeCamera is null ? "Open camera" : "Take photo")
                </button>
                <label class="scan-btn">
                    <span>Choose image</span>
                    <InputFile @key="_fileInputVersion" class="scan-file-hidden" OnChange="ChooseImageAsync"
                               accept="image/*" disabled="@(IsBusy || _cameraOpen)" />
                </label>
            </div>

            <div class="scan-preview" hidden="@(!_cameraOpen)">
                <video @ref="_video" autoplay muted playsinline aria-label="Meter camera preview"></video>
                <div class="scan-actions">
                    <button type="button" class="scan-btn scan-btn-primary" @onclick="CaptureFrameAsync" disabled="@IsBusy">Take photo</button>
                    <button type="button" class="scan-btn" @onclick="CloseCameraAsync">Close camera</button>
                </div>
            </div>

            @if (_preview is not null)
            {
                <div class="scan-preview"><img src="@_preview" alt="Meter photo" /></div>
            }

            @if (_processing)
            {
                <p class="scan-status" role="status">Reading meter photo…</p>
            }

            @if (_scanMessage is not null)
            {
                <p class="scan-status scan-warn" role="status">@_scanMessage</p>
                <div class="scan-actions">
                    <button type="button" class="scan-btn" @onclick="() => SelectTabAsync(false)" disabled="@IsBusy">Enter manually</button>
                </div>
            }

            @if (_automatic && _hasCompleteScan)
            {
                <p class="scan-status scan-success" role="status">Reading detected. Check the value before saving.</p>
                @ReadingForm
            }
        </section>

        <section id="scan-manual-panel" class="scan-panel" role="tabpanel"
                 aria-labelledby="scan-manual-tab" hidden="@_automatic">
            @if (!_automatic)
            {
                @ReadingForm
            }
        </section>
    </div>
</div>

@code {
    private RenderFragment ReadingForm => @<div class="scan-panel">
        <div class="scan-fields">
            <div class="scan-field">
                <label for="scan-fuel">Fuel type</label>
                <select id="scan-fuel" class="scan-select" @bind="_fuelType" disabled="@IsBusy">
                    <option value="">Select fuel type</option>
                    <option value="Electricity">Electricity</option>
                    <option value="Gas">Gas</option>
                </select>
            </div>
            <div class="scan-field">
                <label for="scan-date">Date</label>
                <input id="scan-date" class="scan-input" type="date" @bind="_readingDate" disabled="@IsBusy" />
            </div>
        </div>
        <div class="scan-field">
            <label for="scan-reading">Meter reading</label>
            <input id="scan-reading" class="scan-input" type="number" min="0" max="9999999" step="0.01"
                   @bind="_readingValue" disabled="@IsBusy" />
        </div>

        @if (_saveMessage is not null)
        {
            <p class="scan-status scan-error" role="alert">@_saveMessage</p>
        }

        <div class="scan-actions">
            <button type="button" class="scan-btn scan-btn-primary" @onclick="SaveAsync" disabled="@(!CanSave)">
                @(_saving ? "Saving…" : "Save reading")
            </button>
            <button type="button" class="scan-btn" @onclick="Clear" disabled="@(IsBusy || _cameraOpen)">Clear</button>
        </div>
    </div>;

    private IMeterCamera? _nativeCamera;
    private ElementReference _automaticTab;
    private ElementReference _manualTab;
    private ElementReference _video;
    private string _fuelType = "";
    private DateTime? _readingDate = DateTime.Today;
    private decimal? _readingValue;
    private string? _preview;
    private string? _scanMessage;
    private string? _saveMessage;
    private int _fileInputVersion;
    private bool _cameraOpen;
    private bool _opening;
    private bool _processing;
    private bool _saving;
    private bool _disposed;
    private bool _automatic;
    private bool _hasCompleteScan;
    private SubscriptionStatus? _subscription;

    private bool IsBusy => _opening || _processing || _saving;
    private bool CanSave => !IsBusy && !_cameraOpen && (!_automatic || _hasCompleteScan) && _readingDate.HasValue &&
        (_fuelType is "Electricity" or "Gas") &&
        _readingValue is >= 0 and <= 9999999 && decimal.Round(_readingValue.Value, 2) == _readingValue;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _nativeCamera = Services.GetService(typeof(IMeterCamera)) as IMeterCamera;
        var platform = (Services.GetService(typeof(ISubscriptionPurchases)) as ISubscriptionPurchases)?.Platform ?? "Web";
        try
        {
            _subscription = await Api.GetAsync<SubscriptionStatus>("api/subscriptions/status?platform=" + platform);
            _automatic = _subscription?.CanScan == true;
        }
        catch (Exception)
        {
            _scanMessage = "Subscription status is unavailable. You can enter readings manually.";
        }
    }

    private async Task SelectTabAsync(bool automatic)
    {
        if (IsBusy || _automatic == automatic || automatic && _subscription?.CanScan != true)
            return;

        await CloseCameraAsync();
        _automatic = automatic;
    }

    private async Task HandleTabKeyAsync(KeyboardEventArgs args)
    {
        if (_subscription?.CanScan != true) return;
        var automatic = args.Key switch
        {
            "ArrowLeft" or "ArrowRight" => !_automatic,
            "Home" => true,
            "End" => false,
            _ => _automatic
        };
        if (automatic == _automatic || IsBusy)
            return;

        await SelectTabAsync(automatic);
        await (automatic ? _automaticTab : _manualTab).FocusAsync();
    }

    private async Task OpenCameraAsync()
    {
        if (IsBusy || _cameraOpen)
            return;

        _scanMessage = null;
        _opening = true;
        try
        {
            if (_nativeCamera is not null)
            {
                if (!_nativeCamera.IsSupported)
                {
                    _scanMessage = "Camera capture is unavailable. Choose a photo or enter the reading.";
                    return;
                }

                await using var photo = await _nativeCamera.CaptureAsync();
                if (photo is not null && !_disposed)
                    await AnalyzeAsync(photo);
                return;
            }

            _cameraOpen = true;
            await JS.InvokeVoidAsync("fuelMeterCamera.start", _video);
        }
        catch (Exception)
        {
            _cameraOpen = false;
            _scanMessage = "Could not open the camera. Check camera permissions or choose a photo.";
        }
        finally
        {
            _opening = false;
        }
    }

    private async Task CloseCameraAsync()
    {
        if (!_cameraOpen)
            return;

        _cameraOpen = false;
        try
        {
            await JS.InvokeVoidAsync("fuelMeterCamera.stop", _video);
        }
        catch (JSDisconnectedException)
        {
            // The browser has already disconnected.
        }
    }

    private async Task CaptureFrameAsync()
    {
        if (IsBusy || !_cameraOpen)
            return;

        _opening = true;
        try
        {
            await using var frame = await JS.InvokeAsync<IJSStreamReference>("fuelMeterCamera.capture", _video);
            await CloseCameraAsync();
            await using var stream = await frame.OpenReadStreamAsync(MeterScanRequest.MaxImageBytes);
            await AnalyzeAsync(stream);
        }
        catch (Exception)
        {
            _scanMessage = "Could not capture a photo. Try again or choose an image.";
        }
        finally
        {
            _opening = false;
        }
    }

    private async Task ChooseImageAsync(InputFileChangeEventArgs args)
    {
        if (IsBusy || _cameraOpen)
            return;

        _opening = true;
        try
        {
            if (args.File.Size > 25 * 1024 * 1024)
                throw new IOException();

            var image = await args.File.RequestImageFileAsync("image/jpeg", 2048, 2048);
            await using var stream = image.OpenReadStream(MeterScanRequest.MaxImageBytes);
            await AnalyzeAsync(stream);
        }
        catch (Exception)
        {
            _scanMessage = "Could not open this image. Try a smaller JPEG or PNG.";
        }
        finally
        {
            _opening = false;
            _fileInputVersion++;
        }
    }

    private async Task AnalyzeAsync(Stream stream)
    {
        _preview = null;
        _scanMessage = null;
        _saveMessage = null;
        _hasCompleteScan = false;
        _processing = true;
        StateHasChanged();

        try
        {
            using var buffer = new MemoryStream();
            var chunk = new byte[32 * 1024];
            int read;
            while ((read = await stream.ReadAsync(chunk)) > 0)
            {
                if (buffer.Length + read > MeterScanRequest.MaxImageBytes)
                {
                    _scanMessage = "This photo is too large. Try a smaller image.";
                    return;
                }

                buffer.Write(chunk, 0, read);
            }

            var image = buffer.ToArray();
            var imageType = MeterScanRequest.GetImageType(image);
            if (imageType is null)
            {
                _scanMessage = "Choose a JPEG or PNG photo, or enter the reading manually.";
                return;
            }

            if (_disposed)
                return;

            _preview = $"data:{imageType};base64,{Convert.ToBase64String(image)}";
            StateHasChanged();
            var request = new MeterScanRequest { Image = image, IdempotencyKey = Guid.NewGuid() };
            MeterScanResult? result;
            try
            {
                result = await Api.PostAsync<MeterScanRequest, MeterScanResult>("api/meter-scans", request);
            }
            catch (HttpRequestException ex) when (ex.StatusCode is null or System.Net.HttpStatusCode.Conflict)
            {
                // A lost response must reuse the identifier so a completed scan is not charged twice.
                await Task.Delay(1000);
                result = await Api.PostAsync<MeterScanRequest, MeterScanResult>("api/meter-scans", request);
            }
            if (_disposed)
                return;

            var fuelType = result?.FuelType is "Electricity" or "Gas" ? result.FuelType : null;
            var readingValue = result?.ReadingValue is >= 0 and <= 9999999
                ? decimal.Round(result.ReadingValue.Value, 2)
                : (decimal?)null;
            if (fuelType is not null || readingValue is not null)
            {
                _fuelType = fuelType ?? "";
                _readingValue = readingValue;
            }

            _hasCompleteScan = fuelType is not null && readingValue is not null;
            _scanMessage = (fuelType, readingValue) switch
            {
                (null, null) => "No reading was detected. Try a clearer photo or enter it manually.",
                (null, _) => "The reading was detected. Choose the fuel type in Manual.",
                (_, null) => "The fuel type was detected. Enter the reading in Manual or try a clearer photo.",
                _ => null
            };
        }
        catch (HttpRequestException ex)
        {
            _scanMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Sign in again to analyze a meter photo.",
                System.Net.HttpStatusCode.PaymentRequired => "Your AI scan allowance is unavailable. Check your subscription or enter the reading manually.",
                System.Net.HttpStatusCode.TooManyRequests => "Too many scans. Try again in a minute or enter the reading.",
                System.Net.HttpStatusCode.ServiceUnavailable => "Automatic scanning hasn't been configured on this server.",
                System.Net.HttpStatusCode.BadGateway => "Automatic scanning couldn't complete. Try again or enter the reading manually.",
                System.Net.HttpStatusCode.RequestEntityTooLarge => "This photo is too large. Try a smaller image.",
                _ => "Automatic scanning is unavailable. Try again or enter the reading manually."
            };
        }
        catch (Exception)
        {
            _scanMessage = "Could not analyze the image. Retake it or enter the reading manually.";
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave || AuthState.CurrentUser is not { } user)
            return;

        _saving = true;
        _saveMessage = null;
        try
        {
            var result = await MeterService.SaveAsync(user.Id, new()
            {
                FuelType = _fuelType,
                ReadingDate = _readingDate,
                ReadingValue = _readingValue
            });
            if (result.Success)
                Nav.NavigateTo("/meter-readings");
            else
                _saveMessage = result.Message;
        }
        catch (Exception)
        {
            _saveMessage = "Could not save the reading. Check Meter Readings before retrying.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Clear()
    {
        _preview = null;
        _hasCompleteScan = false;
        _fuelType = "";
        _readingValue = null;
        _scanMessage = null;
        _saveMessage = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await CloseCameraAsync();
    }
}
