@page "/anomalies"
@using FuelMeter.Core.DTOs
@using FuelMeter.Core.Services
@using FuelMeter.Core.Services.Interfaces
@layout MainLayout
@inject IAnomalyService AnomalyService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="anom-page">
    <div class="anom-header">
        <h1 class="anom-title">⚠️ Usage Anomalies</h1>
        <p class="anom-subtitle">
            Days where your daily usage was significantly higher than your rolling 30-day average.
        </p>
    </div>

    <div class="anom-controls">
        <label>
            Fuel:
            <select @bind="_fuelType" @bind:after="LoadAsync">
                <option value="">All</option>
                <option value="Electricity">Electricity</option>
                <option value="Gas">Gas</option>
            </select>
        </label>
        <label>
            Look back (days):
            <select @bind="_daysBack" @bind:after="LoadAsync">
                <option value="30">30</option>
                <option value="60">60</option>
                <option value="90">90</option>
                <option value="180">180</option>
            </select>
        </label>
        <label>
            Threshold % above avg:
            <select @bind="_threshold" @bind:after="LoadAsync">
                <option value="25">25%</option>
                <option value="50">50%</option>
                <option value="75">75%</option>
                <option value="100">100%</option>
            </select>
        </label>
    </div>

    @if (_loading)
    {
        <div class="anom-loading">Loading anomalies…</div>
    }
    else if (_result is null || _result.Anomalies.Count == 0)
    {
        <div class="anom-empty">
            ✅ No anomalies detected for the selected window. Your usage is consistent.
        </div>
    }
    else
    {
        <div class="anom-summary">
            Found <strong>@_result.Anomalies.Count</strong> flagged day(s)
            using a <strong>@_result.ThresholdPercent%</strong> threshold over
            the last <strong>@_result.DaysAnalyzed</strong> days.
        </div>

        <div class="anom-table-wrap">
            <table class="anom-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Fuel</th>
                        <th>Daily Usage</th>
                        <th>30-day Avg</th>
                        <th>% Above</th>
                        <th>Severity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _result.Anomalies)
                    {
                        <tr>
                            <td>@a.Date.ToString("ddd, dd MMM yyyy")</td>
                            <td>
                                <span class="@(a.FuelType == "Electricity" ? "fuel-elec" : "fuel-gas")">
                                    @(a.FuelType == "Electricity" ? "⚡" : "🔥") @a.FuelType
                                </span>
                            </td>
                            <td>@a.DailyUsage.ToString("N2")</td>
                            <td>@a.RollingAverage.ToString("N2")</td>
                            <td class="@(a.Severity == "High" ? "pct-high" : "pct-warn")">
                                +@a.PercentAboveAverage.ToString("N0")%
                            </td>
                            <td>
                                <span class="badge @(a.Severity == "High" ? "badge-high" : "badge-warn")">
                                    @a.Severity
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private AnomalyResultDto? _result;
    private bool _loading = true;
    private string _fuelType = "";
    private int _daysBack = 60;
    private decimal _threshold = 50m;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _result = await AnomalyService.DetectAnomaliesAsync(
                AuthState.CurrentUser!.Id,
                string.IsNullOrEmpty(_fuelType) ? null : _fuelType,
                _daysBack,
                _threshold);
        }
        catch { _result = null; }
        finally { _loading = false; }
    }
}
